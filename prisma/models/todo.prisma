enum TodoState {
  TODO
  IN_PROGRESS
  DONE
  CANCELED

  @@map("todo_state")
}

model Todo {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  state TodoState @default(TODO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("todos")
}
