enum ImageResourceType {
  GALLERY_SECTION
  AVATAR
  PRODUCT_VARIANT
  BANNER

  @@map("image_resource_type")
}

enum ImagePurpose {
  GALLERY_SECTION_IMAGE
  AVATAR_IMAGE
  PRODUCT_VARIANT_IMAGE
  BANNER_IMAGE_RO
  BANNER_IMAGE_MOBILE_RO
  BANNER_IMAGE_RU
  BANNER_IMAGE_MOBILE_RU

  @@map("image_purpose")
}

enum ImageVariantKind {
  THUMB_512x512
  THUMB_256x256

  @@map("image_variant_kind")
}

model Image {
  id           Int               @id @default(autoincrement())
  url          String
  key          String
  customId     String?           @map("custom_id")
  generatedId  String?           @unique @map("generated_id")
  name         String
  size         Int
  mimeType     String            @map("mime_type")
  width        Int
  height       Int
  thumbhash    String?
  resourceType ImageResourceType @map("resource_type")
  resourceId   String?           @map("resource_id")
  purpose      ImagePurpose
  order        Int
  variants     ImageVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([resourceType, resourceId, order])
  @@index([resourceType, resourceId])
  @@map("images")
}

model ImageVariant {
  id      Int              @id @default(autoincrement())
  imageId Int              @map("image_id")
  image   Image            @relation(fields: [imageId], references: [id], onDelete: Cascade)
  kind    ImageVariantKind
  url     String
  key     String
  customId String?         @map("custom_id")
  generatedId String?      @unique @map("generated_id")
  name    String
  size    Int
  width   Int
  height  Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([imageId, kind])
  @@map("image_variants")
}
