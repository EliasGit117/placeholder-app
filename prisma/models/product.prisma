enum ProductState {
  active
  not_available
  hidden

  @@map("product_state")
}

model Product {
  id                 Int              @id @default(autoincrement())
  nameRo             String           @map("name_ro")
  nameRu             String           @map("name_ru")
  shortDescriptionRo String?          @map("short_description_ro")
  shortDescriptionRu String?          @map("short_description_ru")
  state              ProductState     @default(active)
  slug          String           @unique
  options       Json             @default("{}") @map("option_schema")
  variants      ProductVariant[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameRo       String   @map("name_ro")
  nameRu       String   @map("name_ru")
  state        ProductState @default(active)
  slug         String
  fullSlug     String   @unique @map("full_slug")
  sku          String
  optionValues Json     @default("{}") @map("option_values")
  price        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([productId, slug])
  @@index([productId])
  @@index([optionValues(ops: JsonbOps)], type: Gin)
  @@map("product_variants")
}
