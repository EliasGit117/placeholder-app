enum ProductState {
  ACTIVE       @map("active")
  NOT_AVAILABLE @map("not_available")
  HIDDEN       @map("hidden")
  ARCHIVED     @map("archived")

  @@map("product_state")
}

model Product {
  id                 Int              @id @default(autoincrement())
  nameRo             String           @map("name_ro")
  nameRu             String           @map("name_ru")
  shortDescriptionRo String?          @map("short_description_ro")
  shortDescriptionRu String?          @map("short_description_ru")
  state              ProductState     @default(ACTIVE)
  slug          String           @unique
  options       Json             @default("{}") @map("option_schema")
  categoryId    Int?             @map("category_id")
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameRo       String   @map("name_ro")
  nameRu       String   @map("name_ru")
  state        ProductState @default(ACTIVE)
  slug         String
  fullSlug     String   @unique @map("full_slug")
  sku          String
  optionValues Json     @default("{}") @map("option_values")
  price        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([productId, slug])
  @@index([productId])
  @@index([optionValues(ops: JsonbOps)], type: Gin)
  @@map("product_variants")
}
