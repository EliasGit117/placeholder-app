enum ProductState {
  active
  hidden

  @@map("product_state")
}

model Product {
  id            Int              @id @default(autoincrement())
  nameRo        String           @map("name_ro")
  nameRu        String           @map("name_ru")
  descriptionRo String?          @map("description_ro")
  descriptionRu String?          @map("description_ru")
  state         ProductState     @default(active)
  slug          String           @unique
  optionSchema  Json             @default("{}") @map("option_schema")
  variants      ProductVariant[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameRo     String   @map("name_ro")
  nameRu     String   @map("name_ru")
  slug       String
  fullSlug   String   @unique @map("full_slug")
  attributes Json     @default("{}")
  price      Int
  stock      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([productId, slug])
  @@index([productId])
  @@index([attributes(ops: JsonbOps)], type: Gin)
  @@map("product_variants")
}
